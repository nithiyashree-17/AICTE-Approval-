{
  "key": "RE_SCRUTINY",
  "displayName": "Re-Scrutiny / Rectification Review",
  "description": "Scrutiny Officer re-evaluates previously deficient items against the newly submitted evidence versions without modifying historical scrutiny records.",
  "ownerRole": "ROLE_SCRUTINY_OFFICER",
  "permittedRoles": ["ROLE_SCRUTINY_OFFICER", "ROLE_REGIONAL_OFFICER", "ROLE_BUREAU_OFFICER", "ROLE_AUDITOR"],
  "isTerminal": false,
  "aphClauseCitation": "APH 2024-2027 Chapter I Cl. 1.8 & Chapter II Cl. 2.19",
  "entryPrerequisites": [
    {
      "code": "PRE_RESUBMITTED_EVIDENCE",
      "description": "Application must contain new document versions uploaded during DEFICIENCY_RESPONSE."
    }
  ],
  "allowedTransitions": [
    {
      "transitionName": "CLEAR_RE_SCRUTINY_TO_EVC",
      "targetStage": "EVC_PENDING",
      "buttonLabel": "Clear Re-Scrutiny & Forward to EVC",
      "authorizedRoles": ["ROLE_SCRUTINY_OFFICER"],
      "requiresEvidence": true,
      "requiresReason": false,
      "requiredEvidenceTypes": ["RE_SCRUTINY_CLEARANCE_REPORT"],
      "aphRuleCitation": "RULE-NEW-004 / Chap I Cl. 1.8",
      "validationRules": [
        "100% of previously flagged deficiencies must be evaluated as RESOLVED",
        "Re-scrutiny signed verification memo uploaded"
      ],
      "sideEffects": {
        "createOutboxEvent": "RE_SCRUTINY_CLEARED_RECOMMENDED_EVC",
        "triggerNotificationPolicy": "EVC_PENDING_COORDINATOR_ALERT",
        "startTimerPolicy": "EVC_SCHEDULING_SLA"
      }
    },
    {
      "transitionName": "CLEAR_RE_SCRUTINY_TO_DECISION",
      "targetStage": "DECISION_PENDING",
      "buttonLabel": "Clear Re-Scrutiny & Forward for Approval (EVC Exempt)",
      "authorizedRoles": ["ROLE_SCRUTINY_OFFICER"],
      "requiresEvidence": true,
      "requiresReason": true,
      "requiredEvidenceTypes": ["RE_SCRUTINY_CLEARANCE_REPORT"],
      "aphRuleCitation": "RULE-CHG-002 / Chap II Table 2.3",
      "validationRules": [
        "All deficiencies evaluated as RESOLVED",
        "Application category must be exempt from physical EVC"
      ],
      "sideEffects": {
        "createOutboxEvent": "RE_SCRUTINY_CLEARED_TO_DECISION",
        "triggerNotificationPolicy": "DECISION_PENDING_NOTIFICATION"
      }
    },
    {
      "transitionName": "REFER_PERSISTENT_DEFICIENCY_TO_SHC",
      "targetStage": "HEARING_OR_COMMITTEE_REVIEW",
      "buttonLabel": "Refer to Standing Hearing Committee (Persistent Deficiency)",
      "authorizedRoles": ["ROLE_SCRUTINY_OFFICER", "ROLE_REGIONAL_OFFICER"],
      "requiresEvidence": true,
      "requiresReason": true,
      "requiredEvidenceTypes": ["PERSISTENT_DEFICIENCY_STATEMENT"],
      "aphRuleCitation": "RULE-SHC-001 / Chap II Cl. 2.19, 2.20",
      "validationRules": [
        "At least one deficiency remains UNRESOLVED after re-scrutiny",
        "Itemized Discrepancy Statement compiled for SHC bench"
      ],
      "sideEffects": {
        "createOutboxEvent": "REFERRED_TO_SHC_FROM_RE_SCRUTINY",
        "triggerNotificationPolicy": "HEARING_SUMMONS_NOTIFICATION",
        "triggerEscalationPolicy": "DEFICIENCY_RESPONSE_ESCALATION"
      }
    }
  ],
  "timePolicy": {
    "type": "PROTOTYPE_POLICY",
    "durationValue": 3,
    "durationUnit": "WORKING_DAYS",
    "description": "Re-Scrutiny SLA: Scrutiny Officer must complete re-evaluation within 3 working days.",
    "warningOffsets": [-1, 0],
    "isStrictStatutoryCutoff": false
  },
  "evidenceRequirements": ["RE_SCRUTINY_CLEARANCE_REPORT", "PERSISTENT_DEFICIENCY_STATEMENT"],
  "exitConditions": [
    {
      "code": "EXIT_RE_SCRUTINY_COMPLETED",
      "description": "All deficiencies marked RESOLVED or formal SHC referral docket generated.",
      "verificationCriteria": [
        "re_scrutiny_status in ['RESOLVED', 'REFERRED_TO_SHC']"
      ]
    }
  ]
}
