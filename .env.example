# ==============================================================================
# AICTE FlowGuard - Environment Configuration Template (.env.example)
# Problem Statement ID: 26262
# Copy this file to .env and adjust values for your local environment.
# NEVER commit real credentials or actual secrets to source control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT_API=4000
PORT_WEB=3000

# Web & API URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aicte_flowguard?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aicte_flowguard

# Redis & BullMQ Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# Object Storage (MinIO S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=aicte-documents
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true

# Authentication & Session
AUTH_SECRET="change-this-to-a-secure-random-secret-for-jwt-and-session-signing-at-least-32-chars"
AUTH_EXPIRES_IN="8h"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Development & Demo Controls
# Set to 'false' in production or staging environments
ENABLE_DEMO_ACCOUNT_SWITCHER=true

# Email Adapter Configuration
# Modes: mock | smtp | resend
EMAIL_PROVIDER_MODE=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AICTE FlowGuard <notifications@flowguard.local>"
RESEND_API_KEY=

# Optional AI Adapter Configuration (Advisory only; never decision-making)
AI_ADAPTER_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
