{
  "name": "aicte-flowguard",
  "version": "0.1.0",
  "private": true,
  "description": "AICTE FlowGuard - Integrated Approval Workflow Automation, Compliance Monitoring and Alert Management System (Problem ID 26262)",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:app": "pnpm --parallel --filter web --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "demo": "npm --prefix apps/web run dev",
    "demo:pnpm": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "test:unit": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" test",
    "test:integration": "pnpm --filter api test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:reset": "node scripts/test_db_reset.js && playwright test",
    "prisma:generate": "pnpm --filter api prisma:generate",
    "prisma:migrate": "pnpm --filter api prisma:migrate",
    "prisma:studio": "pnpm --filter api prisma:studio",
    "db:seed": "pnpm --filter api db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "keywords": [
    "aicte",
    "workflow-automation",
    "compliance-monitoring",
    "bullmq",
    "nextjs",
    "nestjs",
    "prisma"
  ],
  "author": "AICTE FlowGuard Team",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "dotenv": "^18.0.8",
    "prisma": "5.22.0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  }
}
